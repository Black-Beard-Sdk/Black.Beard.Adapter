@inherits ComponentFieldBase<char>
@using MudBlazor


<MudTextField T="char"
              Class="fontPropertyGrid"
              Label="@GetDisplay()"
              HelperText="@GetDescription()"
              @bind-Value="Value"
              Validation="Validate"
              Disabled="@ReadOnly"
              Format="@FormatString"
              Variant="@CurrentVariant"
              Margin="@CurrentMargin"
              onfocus="@OnFocus" />
