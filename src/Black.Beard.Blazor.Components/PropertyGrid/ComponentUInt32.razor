@inherits ComponentFieldBase<UInt32>
@using MudBlazor

    <MudNumericField T="UInt32"
                     @bind-Value="Value"
                     Class="fontPropertyGrid"
                     Label="@GetDisplay()"
                     HelperText="@GetDescription()"
                     Disabled="@ReadOnly"
                     Validation="Validate"
                     Format="@FormatString"
                     Variant="@CurrentVariant"
                     Margin="@CurrentMargin"
                     Min="@GetMinimum()"
                     Max="@GetMaximum()"
                     Step="@GetStep()"
                     onfocus="@OnFocus" />
