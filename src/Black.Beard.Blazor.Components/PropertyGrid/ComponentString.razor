@inherits ComponentFieldBase<string>
@using MudBlazor


<MudTextField T="string"
              Class="fontPropertyGrid"
              Label="@GetDisplay()"
              HelperText="@GetDescription()"
              @bind-Value="Value"
              Validation="Validate"
              Disabled="@ReadOnly"
              Format="@FormatString"
              MaxLength="@Maximum"
              Variant="@CurrentVariant"
              Margin="@CurrentMargin"
              Lines="@Line"
              InputType="@inputType"
              onfocus="@OnFocus" />

