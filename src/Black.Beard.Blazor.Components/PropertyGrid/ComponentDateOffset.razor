@inherits ComponentFieldBase<DateTimeOffset>
@using MudBlazor

<MudTextField Class="fontPropertyGrid"
              T="DateTimeOffset"
              Label="@GetDisplay()"
              HelperText="@GetDescription()"
              @bind-Value="Value"
              Validation="Validate"
              Disabled="@ReadOnly"
              Format="@FormatString"
              Variant="@CurrentVariant"
              Margin="@CurrentMargin"
              onfocus="@OnFocus" />

