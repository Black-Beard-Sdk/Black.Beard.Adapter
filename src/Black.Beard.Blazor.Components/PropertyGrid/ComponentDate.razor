@inherits ComponentFieldBase<DateTime>
@using MudBlazor

<MudDatePicker Class="fontPropertyGrid"
               Label="@GetDisplay()"
               Placeholder="@GetDescription()"
               Editable="@(!ReadOnly)"
               @bind-Date="Date"
               Variant="@CurrentVariant"
               Margin="@CurrentMargin"
               onfocus="@OnFocus" />

