@inherits ComponentFieldBase<UInt16>
@using MudBlazor

<MudNumericField T="UInt16"
                 Class="fontPropertyGrid"
                 @bind-Value="Value"
                 Label="@GetDisplay()"
                 HelperText="@GetDescription()"
                 Validation="Validate"
                 Disabled="@ReadOnly"
                 Format="@FormatString"
                 Variant="@CurrentVariant"
                 Margin="@CurrentMargin"
                 Min="@GetMinimum()"
                 Max="@GetMaximum()"
                 Step="@GetStep()"
                 onfocus="@OnFocus" 
                 />
