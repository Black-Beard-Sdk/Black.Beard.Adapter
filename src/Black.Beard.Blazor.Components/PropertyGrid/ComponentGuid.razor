@inherits ComponentFieldBase<Guid>
@using MudBlazor


<MudTextField T="string"
              Class="fontPropertyGrid"
              Label="@GetDisplay()"
              HelperText="@GetDescription()"
              @bind-Value="ValueString"
              Validation="Validate"
              Disabled="@ReadOnly"
              Format="@FormatString"
              Mask="TagMask"
              Variant="@CurrentVariant"
              Margin="@CurrentMargin"
              InputType="@InputType"
              onfocus="@OnFocus" />
